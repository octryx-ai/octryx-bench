  "conditions": [
    {
      "word": "bereit",
      "definition": "remainingG>0,readyDate≤heute,heute<roastDate+45 für Methode"
    },
    {
      "word": "ruht",
      "definition": "heute<readyDate,Resttage=readyDate−heute"
    },
    {
      "word": "zu alt",
      "definition": "heute≥roastDate+45"
    },
    {
      "word": "leer",
      "definition": "remainingG0 oder keine nicht archivierten Listeneinträge"
    },
    {
      "word": "ausserhalb Referenzbereich",
      "definition": "Mindestens ein gemessener Wert verletzt R2"
    },
    {
      "word": "gemessene Werte im Referenzbereich",
      "definition": "Alle nicht-null Werte inR2,immer n/6"
    },
    {
      "word": "nicht gemessen",
      "definition": "Feld=null,nicht0"
    },
    {
      "word": "niedriger Bestand",
      "definition": "Nicht alter Bestand≤Verbrauch×(Lieferzeit+Ruhe)+Minimum"
    },
    {
      "word": "ohne Historie",
      "definition": "Weder berücksichtigte Brew noch ConsumptionEvent im28-Tage-Fenster"
    },
    {
      "word": "Lücke",
      "definition": "Tagesweise volle Nachfrage nicht aus an diesem Tag bereiten nicht alten Packs deckbar"
    },
    {
      "word": "fällig",
      "definition": "Ein Limit dieser Aufgabe seit ihrem letzten passenden CareEvent erreicht"
    },
    {
      "word": "Skalenende",
      "definition": "Kandidat ausserhalb scaleMin..scaleMax,R9/R11 begrenzen"
    },
    {
      "word": "Bohnenwechsel",
      "definition": "Letzte bestätigte beanId dieser grinderId unterscheidet sich"
    },
    {
      "word": "ungenutzt",
      "definition": "Seit bestätigter Mahlung dieser grinderId≥24 h"
    },
    {
      "word": "archiviert",
      "definition": "deletedAt!=null,Historie auflösbar,Auswahl ausgeschlossen"
    },
    {
      "word": "pausiert",
      "definition": "status=paused,pausedAt gesetzt,effectiveNow=pausedAt"
    },
    {
      "word": "bestätigter Purge",
      "definition": "Vom Nutzer bestätigte tatsächliche purgeG,nicht nur vorgeschlagene deadSpaceG"
    }
  ],
  "rules": [
    {
      "id": "R1",
      "title": "Härte",
      "text": "1 °fH=10 ppm,1 °dH=17.848 ppm;Anzeige1 Dezimale.",
      "identifier": "hardnessPpm",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "15 °fH;8.4 °dH",
          "expect": "150.0 ppm;149.9 ppm",
          "realistic": true
        }
      ]
    },
    {
      "id": "R2",
      "title": "Wasser zuerst",
      "text": "TDS75–250,Gesamthärte50–175,Alkalinität40–75 ppm,pH6.5–7.5,Natrium≤10 mg/L,Chlor0. Produkt-Literaturprofil,null nicht gemessen,n/6 zeigen.",
      "identifier": "waterRules",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "30 °fH",
          "expect": "300 ppm,125 ppm über Maximum,Wasser zuerst",
          "realistic": true
        }
      ]
    },
    {
      "id": "R3",
      "title": "Bereitschaft und Sortierung",
      "text": "readyDate=roastDate+Ruhe;Filter7/5/4/3,Espresso14/10/7/5 Tage nach Röstgrad;alt ab45 Tage. Bohnen gruppiert0 bereit nicht alt Rest>0,1 nur ruhend,2 nur alt,3 leer. Datum nur qualifizierender Packs,dann lowercaseName,createdAt,id;Gruppe2/3 Datum unendlich. Filter-Blends nachrangig.",
      "identifier": "restDays",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "medium01.11.2026",
          "expect": "Filter06.11.,Espresso11.11.,alt16.12.",
          "realistic": true
        },
        {
          "given": "A leere Packung01.11.+ruhende25.11.;B50 g bereit11.11.",
          "expect": "B Gruppe0 vor A Gruppe1",
          "realistic": true
        }
      ]
    },
    {
      "id": "R4",
      "title": "Verbrauch einschliesslich Waste",
      "text": "Summe bestätigter Brew.doseG+Brew.purgeG und ConsumptionEvent.wasteG per packId der Bohne in28 vollständigen lokalen Tagen/28,jeden Verbrauch einmal. Ohne Historie=nicht eine berücksichtigte Brühung und nicht ein berücksichtigtes ConsumptionEvent;leeres Fenster0.",
      "identifier": "consumptionPerDay",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "Nur56 g Waste in28 Tagen",
          "expect": "2 g/Tag,Standardminimum4 g,Historie vorhanden",
          "realistic": true
        }
      ]
    },
    {
      "id": "R5",
      "title": "Bestellpunkt",
      "text": "Minimum manuell oder2 Verbrauchstage,ohne Historie100 g;Bestellpunkt=Verbrauch×(leadTimeDays+Ruhe)+Minimum,leadTimeDays Standard3 Tage. Hinweis bei≤. Bar orderPoint0 ohne Division:Bestand>0 voll success,sonst leer error,keine Schwellenmarke.",
      "identifier": "orderPoint",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "18 g/Tag,Lieferung3 Tage,Ruhe10 Tage,250 g",
          "expect": "Minimum36 g,Bestellpunkt270 g,Bestellhinweis",
          "realistic": true
        },
        {
          "given": "Minimum0,Verbrauch0,Bestand250 g",
          "expect": "Voller grüner Balken,keine Schwellenmarke,Kein Mindestbestand",
          "realistic": true
        }
      ]
    },
    {
      "id": "R6",
      "title": "Autoritative Tages-Simulation",
      "text": "Tagesbeginn Bereitschaft/Alter je Packung prüfen,dann volle Tagesnachfrage decken;Zwischenpackungen und Ablauf beachten.Jede zusammenhängende Lücke von–bis mit Aktion.Ohne Verbrauch keine Prognose.Aggregat heute+floor(B/Verbrauch)−1 nur falls im ganzen betrachteten Zeitraum keine Packung bereit/alt wird,nie statt Simulation.",
      "identifier": "runOutDate",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "16.11.,90 g bei18 g/Tag,36 g ab21.11.,nächste25.11.",
          "expect": "16.–20.11. durch90 g,21.–22.11. durch36 g,Lücke23.–24.11.",
          "realistic": true
        }
      ]
    },
    {
      "id": "R7",
      "title": "Tatsächlicher bestätigter Purge",
      "text": "Bei beanId-Wechsel oder≥24 h ungenutzt deadSpaceG vorschlagen.Nur bestätigte tatsächliche purgeG speichern und abziehen;Hinweis,Vorbelegung und unbestätigter Entwurf buchen0.",
      "identifier": "purgeG",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "Vorschlag2.5 g,tatsächlich bestätigt1 g,Dosis17 g",
          "expect": "18 g Verbrauch,nicht19.5 g",
          "realistic": true
        }
      ]
    },
    {
      "id": "R8",
      "title": "Pflege pro Aufgabe",
      "text": "Machine.backflushDays7,backflushShots200,brewSecondsLimit null nur Backflush,descaleDaysOverride null;Grinder.grinderCleanDays28. Positive gesetzte Integer. Entkalkung ohne Override bei>150/100–150/<100 ppm30/60/90 Tage. Backflush-Abschluss setzt eigene Tage/Shots/Sekunden,Entkalken eigene Tage,Mühle eigene Tage;createdOn ohne Ereignis. Handbuchvorrang,backflushSupported=false.",
      "identifier": "careRules",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "Backflush-Sekunden2970+30,Limit3000,danach Entkalken",
          "expect": "Backflush fällig,Stand bleibt3000 s;erst Backflush-Abschluss setzt0 s",
          "realistic": true
        }
      ]
    },
    {
      "id": "R9",
      "title": "Espresso-Ergebnisse",
      "text": "Priorität water,rest,grind/none. Ziel25–30 s/1:2;unter25 feiner,über30 gröber,2 Schritte nur unter20/über35.Im Fenster sauer/schwach feiner,bitter gröber,balanced none. Echte Skala/Richtung,Skalenende,Grund/Quelle.",
      "identifier": "grindSetting",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "M1 min1 max30 Schritt0.5 finerDirection down,Einstellung12.0,sauer27 s,Wasser im Bereich,Pack Espresso-bereit nicht alt",
          "expect": "grind11.5,nur Mahlgrad ändern",
          "realistic": true
        }
      ]
    },
    {
      "id": "R10",
      "title": "Gerundeter Filterplan",
      "text": "Ratio16,14–18 Schritt0.5. Zuerst waterTotalG=roundHalfUp(doseG×ratio),bloomG=roundHalfUp(2×doseG),dann Ziele roundHalfUp(.375W),roundHalfUp(.6875W),W. .5 aufrunden,keine Dosisrundung,Inkremente aus gerundeten Zieldifferenzen. Offsets0/45/75/120 s,Ziel180–210 s,92–96 °C. Andere Methoden als Produktschema.",
      "identifier": "filterRecipe",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "Hario V60,20 g/1:16",
          "expect": "W320,Bloom40,Ziele40/120/220/320 g",
          "realistic": true
        },
        {
          "given": "15.25 g/1:15",
          "expect": "W228.75→229,Bloom30.5→31,Ziele31/86/157/229,Inkremente31/55/71/72 g",
          "realistic": true
        }
      ]
    },
    {
      "id": "R11",
      "title": "Filter-Ergebnistypen",
      "text": "water vor rest,dann grind oder none. >240 s gröber,<165 feiner je1;>270/<150 je2. Im Fenster sauer/schwach feiner,bitter gröber,balanced none. Nur numerischer Brühparametervorschlag ist Mahlgrad;Wasser/Ruhehinweise sind zulässige vorrangige Ergebnisse.",
      "identifier": "filterRecommendation",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "Balanced200 s,Wasser im Bereich,Pack bereit",
          "expect": "none,keine Änderung",
          "realistic": true
        },
        {
          "given": "Gleiche Brühung,Härte300 ppm",
          "expect": "water,kein zusätzlicher Mahlgradvorschlag",
          "realistic": true
        }
      ]
    },
    {
      "id": "R12",
      "title": "Persistenz,aktive Pause und kanonischer Import",
      "text": "drift/SQLite nativ/Wasm,Transaktionen,UUID-operationId,Snapshots/Soft Delete.Timerentwurf startedAt,accumulatedPausedMs0,pausedAt null,status running/paused,stoppedElapsedS null. Pause setzt pausedAt atomar;effectiveNow=pausedAt wenn paused sonst now;elapsed=floor(max(0,effectiveNow−startedAt−accumulatedPausedMs)/1000). Resume addiert now−pausedAt zu accumulatedPausedMs und leert pausedAt. Background/Neustart erhält Zustand. Import≤10 MiB: genau schemaVersion Integer1,exportedAt UTC-RFC3339-ms-String,grinders/machines/waterProfiles/beans/packs/brews/careEvents/consumptionEvents Arrays,settings Objekt mit hardnessUnit fH/dH/ppm. Fehlend/zusätzlich/falscher Typ/null/unbekannte Einheit→vollständig ablehnen. settings lokales Singleton,atomar ersetzen;Arrays neuer updatedAt gewinnt,Tombstones bleiben. Restore in frische DB.",
      "identifier": "operationId",
      "numeric": true,
      "params": [],
      "examples": [
        {
          "given": "250−17−2.5 g,gleiche operationId zweimal",
          "expect": "230.5 g auch nach Neustart",
          "realistic": true
        },
        {
          "given": "Start10:00:00,Pause10:00:10,Neustart10:00:20,Resume10:00:25,Stop10:00:35",
          "expect": "Neustart10 s,Pause15000 ms,Stop20 s",
          "realistic": true
        },
