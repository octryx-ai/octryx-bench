<mxfile host="app" version="1.0">
  <diagram name="data-flow" id="data-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1"
                  pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="1"/>
        <mxCell
          id="d1"
          value="shared_preferences&lt;br&gt;onboardingDone"
          style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#E6EEF7;strokeColor=#3A5F8A;"
