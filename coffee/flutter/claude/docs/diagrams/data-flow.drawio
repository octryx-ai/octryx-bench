          parent="1">
          <mxGeometry x="340" y="460" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell
          id="g1"
          value="read"
          style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;"
          edge="1"
          parent="1"
          source="d1"
          target="d2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell
          id="g2"
          value="flag or null"
          style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;"
