          parent="1">
          <mxGeometry x="40" y="60" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell
          id="d2"
          value="SharedPreferencesFlagStore&lt;br&gt;read / write"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E9DC;strokeColor=#7F4527;"
